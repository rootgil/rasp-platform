# =============================================================================
# rasp-platform — PRODUCTION environment
# Copy to .env.production on the VPS. Never commit real secrets.
#
# Reverse-proxy (Caddy) MUST terminate TLS. Do NOT expose ports 3000/4000 on
# the public internet — only 80/443 via docker-compose.prod.yml.
# =============================================================================

NODE_ENV="production"

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Neon PostgreSQL (sslmode=require minimum; prefer sslmode=verify-full + DATABASE_SSL_VERIFY=true)
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/rasp_platform?sslmode=require"

# Auth secrets — MUST be strong unique values (openssl rand -base64 32).
# Template values (change-me, …) are REJECTED at boot in production.
AUTH_SECRET="REPLACE-WITH-openssl-rand-base64-32"
NEXTAUTH_SECRET="REPLACE-WITH-openssl-rand-base64-32-DIFFERENT"

# Public HTTPS URLs (no localhost)
NEXTAUTH_URL="https://rasp.example.com"
NEXT_PUBLIC_APP_URL="https://rasp.example.com"

# CORS allow-list (comma-separated) — your public origin(s)
CORS_ALLOWED_ORIGINS="https://rasp.example.com"

# Internal Docker DNS to collector (not localhost)
COLLECTOR_INTERNAL_URL="http://collector:4000"

# Redis (BullMQ + System Health) — REQUIRED. Same network as docker-compose redis service.
# Host-only (no Docker DNS): redis://localhost:6379
REDIS_URL="redis://redis:6379"

# Envelope encryption — REQUIRED in production; MUST match collector KEK_MASTER_KEY
# Generate once: openssl rand -base64 32
KEK_MASTER_KEY="REPLACE-WITH-openssl-rand-base64-32"

# Ed25519 policy signing — generate once (see DEPLOY.md § 3b). Never use the dev key pair.
POLICY_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
POLICY_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Verify Postgres TLS certificates
DATABASE_SSL_VERIFY="true"

# Disable public Swagger in production (set true only behind admin auth if needed)
DOCS_ENABLED="false"

# ── REQUIRED for email (invites / password reset) ─────────────────────────────

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="REPLACE-ME"
SMTP_FROM="noreply@example.com"

# ── ONE-SHOT seed only (inside container: docker compose … run --rm migrate pnpm db:seed:prod) ─
# Host does not need pnpm. Remove these vars after first run.

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="REPLACE-WITH-strong-password"
