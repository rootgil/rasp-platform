# Copy this file to .env.production and fill in the real values on your VPS.
# .env.production is gitignored - never commit it.

# Neon PostgreSQL connection string (sslmode=require is mandatory)
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/rasp_platform?sslmode=require"

# NextAuth / Auth.js secrets - generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
NEXTAUTH_SECRET="change-me"

# Public URL of your VPS (used by NextAuth for callbacks)
NEXTAUTH_URL="https://rasp.example.com"

# rasp-collector internal URL (leave empty if collector is not running yet)
COLLECTOR_INTERNAL_URL="http://localhost:4000"

# Platform admin account - used only by `pnpm db:seed:prod`
# Run once after first deploy, then remove from env or rotate the password.
SEED_ADMIN_EMAIL="admin@rasp.io"
SEED_ADMIN_PASSWORD="change-me-strong-password"
