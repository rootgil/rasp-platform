# =============================================================================
# rasp-platform — DEVELOPMENT environment
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Neon PostgreSQL — https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/rasp_platform?sslmode=require"

# Auth secrets — generate with: openssl rand -base64 32
# Dev may use placeholders; production MUST use strong unique values (see .env.production.example).
NEXTAUTH_SECRET="change-me-use-openssl-rand-base64-32"
AUTH_SECRET="change-me-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public URL used in invite / password-reset emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CORS allow-list (comma-separated). Used by next.config.ts for /api/*
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Policy signing (Ed25519). REQUIRED if you publish signed policies.
# The PEM below is the DEV key matching the agent's pinned dev public key.
# NEVER use this pair in production.
POLICY_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIIBJTx2h9TZetMcK/NDL/dYH/tv7BMKmcKTZjjFqppyI\n-----END PRIVATE KEY-----"
POLICY_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAI/7DX+UlM7pdHvIPZXGBtr7WvYKi3ZnRY7QtOhiFufM=\n-----END PUBLIC KEY-----"

# Seed credentials — REQUIRED before `pnpm db:seed`
# NEVER use weak values (admin1234, demo1234, etc.). Generate: openssl rand -base64 16
SEED_ADMIN_PASSWORD="CHANGEME-use-openssl-rand-base64-16"
SEED_DEMO_PASSWORD="CHANGEME-use-openssl-rand-base64-16"

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Collector health / internal calls.
# Host / pnpm: http://localhost:4000
# Docker Compose: http://collector:4000
COLLECTOR_INTERNAL_URL="http://collector:4000"

# Envelope encryption KEK — MUST match collector/.env KEK_MASTER_KEY when set.
# Empty = encryption disabled (plaintext payloads, dev only).
# Generate: openssl rand -base64 32
KEK_MASTER_KEY=""

# Set true to verify Postgres TLS certs (recommended when using sslmode=verify-full)
DATABASE_SSL_VERIFY="false"

# API docs at /docs (default: enabled in development)
DOCS_ENABLED="true"

# Email (Gmail SMTP) — optional; needed for invites / password reset
# App password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="you@gmail.com"
