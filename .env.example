# Neon PostgreSQL - get your URL at https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/rasp_platform?sslmode=require"

NEXTAUTH_SECRET="change-me-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="change-me-use-openssl-rand-base64-32"

# Set once your collector is running (rasp-collector repo)
COLLECTOR_INTERNAL_URL="http://localhost:4000"

# ── Policy signing (Ed25519) ──────────────────────────────────────────────────
# One-time bootstrap. See README → "Policy signing bootstrap".
# Private key stays on the control plane only; NEVER commit a production key.
# The value below is the DEV private key matching the agent's pinned dev public
# key — replace it in production with a freshly generated pair.
POLICY_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIIBJTx2h9TZetMcK/NDL/dYH/tv7BMKmcKTZjjFqppyI\n-----END PRIVATE KEY-----"
POLICY_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAI/7DX+UlM7pdHvIPZXGBtr7WvYKi3ZnRY7QtOhiFufM=\n-----END PUBLIC KEY-----"

# ── Payload encryption (envelope encryption KEK) ──────────────────────────────
# One-time bootstrap. See README → "Payload encryption bootstrap".
# MUST be the SAME value as collector/.env KEK_MASTER_KEY.
# Generate once with: openssl rand -base64 32
# Empty = encryption disabled (payloads stored as plaintext, dev only).
KEK_MASTER_KEY=""
